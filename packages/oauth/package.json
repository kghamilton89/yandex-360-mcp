{
  "name": "yandex-360-oauth",
  "version": "0.1.0",
  "description": "Yandex OAuth (PKCE + verification code) login and token storage shared by the yandex-360-mcp servers",
  "license": "MIT",
  "author": "Kenneth Hamilton",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kghamilton89/yandex-360-mcp.git",
    "directory": "packages/oauth"
  },
  "keywords": ["yandex", "yandex-360", "oauth", "pkce"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

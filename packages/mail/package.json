{
  "name": "yandex-mail-mcp",
  "version": "0.1.0",
  "description": "MCP server for Yandex 360 Mail (IMAP/SMTP): search, read, send, organize",
  "license": "MIT",
  "author": "Kenneth Hamilton",
  "type": "module",
  "bin": {
    "yandex-mail-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kghamilton89/yandex-360-mcp.git",
    "directory": "packages/mail"
  },
  "keywords": ["mcp", "model-context-protocol", "yandex", "yandex-360", "yandex-mail", "imap", "smtp"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "imapflow": "^2.9.1",
    "mailparser": "^3.12.4",
    "nodemailer": "^10.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

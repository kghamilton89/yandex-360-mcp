{
  "name": "yandex-calendar-mcp",
  "version": "0.2.0",
  "description": "MCP server for Yandex 360 Calendar (CalDAV): list, create, update, delete events",
  "license": "MIT",
  "author": "Kenneth Hamilton",
  "type": "module",
  "bin": {
    "yandex-calendar-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kghamilton89/yandex-360-mcp.git",
    "directory": "packages/calendar"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "yandex",
    "yandex-360",
    "yandex-calendar",
    "caldav"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ical.js": "^2.2.1",
    "timezones-ical-library": "^2.3.2",
    "tsdav": "^2.5.0",
    "yandex-360-oauth": "^0.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
